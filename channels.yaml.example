# FinFolio YouTube Channels Configuration
#
# Add financial/investment YouTube channels you want to monitor
# Get channel IDs from YouTube: Go to channel → About → Copy the channel ID
#
# Format:
# channels:
#   - channel_id: "UCxxxxx"
#     display_name: "Channel Name"

channels:
  # Example channels - replace with your own
  - channel_id: "UC7kCeZ53sli_9XwuQeFxLqw"
    display_name: "Ticker Symbol YOU"
  - channel_id: "UC9TwYQOO9mAxoF4v8ZioySg"
    display_name: "Tom Crosshill EU"
  
  # Add more channels below:
  # - channel_id: "UCxxxxx"
  #   display_name: "Your Channel Name"
