{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transcript Summary Output",
  "description": "Output schema for finfolio summarization module. Written to storage/summaries/{video_id}.json.",
  "type": "object",
  "required": ["summary", "claims", "metadata"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 150,
      "maxLength": 10000,
      "description": "Plain-language summary of key investment insights (150-400 words typical)"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "description": "List of discrete, verifiable factual claims extracted from transcript (separated from opinions/forecasts)",
      "items": {
        "type": "object",
        "required": ["type", "claim", "quote"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["number", "date", "deal", "company-fact", "product-fact"],
            "description": "Category of factual claim"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "The factual statement (1-2 sentences)"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "description": "Exact source text from transcript (evidence)"
          },
          "source_timestamp": {
            "type": "string",
            "pattern": "^\\d{1,2}:\\d{2}:\\d{2}$",
            "description": "Video timestamp HH:MM:SS where claim was spoken (optional)"
          },
          "confidence_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "LLM confidence that this is factual (0.0-1.0, optional)"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "required": ["transcript_tokens", "model", "temperature", "timestamp"],
      "properties": {
        "transcript_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated token count of input transcript"
        },
        "model": {
          "type": "string",
          "description": "LLM model used (e.g., claude-haiku-4-5-20251001)"
        },
        "temperature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "Temperature parameter used (typically 0.3 for summarization)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when summary was generated (ISO8601)"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0.0,
          "description": "Estimated cost of this LLM call in USD (optional)"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "LLM input token count (optional)"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "LLM output token count (optional)"
        },
        "transcript_truncated": {
          "type": "boolean",
          "description": "True if input was truncated due to context length (optional)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
