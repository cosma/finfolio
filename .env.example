# FinFolio Configuration (.env file)
#
# Copy this file to .env and fill in your values
# The .env file is automatically loaded by finfolio
#
# YouTube Data API v3 Key
# Get one at: https://console.cloud.google.com
# → APIs & Services → Credentials → Create API Key
YOUTUBE_API_KEY=AIzaSyD_your_actual_api_key_here

# Anthropic API Configuration
# Get your API key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM Model Configuration
# Module 2: Summarization (cost-optimized)
# Default: claude-haiku-4-5-20251001 (cheap, fast, good enough for summarization)
FINFOLIO_LLM_MODEL_SUMMARIZATION=claude-haiku-4-5-20251001

# Module 3: Fact-Checking
# Use Haiku (cheap, deterministic) per Constitution VII
FINFOLIO_LLM_MODEL=claude-haiku-4-5-20251001

# Tavily Web Search API Key (required for Module 3 fact-checking)
# Get yours from: https://tavily.com/
TAVILY_API_KEY=tvly-your-actual-tavily-api-key-here

# Storage directory (optional, default: ./storage)
FINFOLIO_STORAGE_DIR=./storage

# Search timeout in seconds (optional, default: 10)
FINFOLIO_SEARCH_TIMEOUT=10

# Logging level (optional, default: INFO)
# DEBUG, INFO, WARNING, ERROR
FINFOLIO_LOG_LEVEL=INFO
